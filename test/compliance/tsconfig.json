{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": null,
		"rootDir": null,
		"types": ["node"],
		// import.meta requires an ES-module target. ES2022 matches the root
		// build's target (and therefore its useDefineForClassFields semantics)
		// for the src/ files this suite pulls in — the earlier es2020 pin's
		// "match the root" rationale went stale when the root moved to ES2022,
		// and its es2020 lib lacked the Error `cause` option src/errors.ts and
		// scripted-server.ts use (the two long-standing typecheck:compliance
		// errors, cleared at M6.2's follow-up).
		"target": "es2022",
		"module": "es2022",
		"moduleResolution": "node",
		// "node" (aka "node10") is deprecated as of TS 6; this suite
		// deliberately keeps it (see above) rather than adopting "bundler"/
		// "node16" resolution semantics as part of an unrelated modernization.
		"ignoreDeprecations": "6.0",
		// Third-party .d.ts (vitest/vite/rollup) target newer TypeScript and lib
		// versions than the repo pins; only this suite's own files need checking.
		// (`node:` specifiers are covered by types/node-prefixed-modules.d.ts
		// until @types/node is bumped past v12.)
		"skipLibCheck": true
	},
	"include": ["./**/*"]
}
