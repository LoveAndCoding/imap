{
	"name": "@lovely-inbox/imap",
	"version": "0.9.0",
	"author": "Alexis Hushbeck",
	"contributors": [
		"Brian White <mscdex@mscdex.net>"
	],
	"description": "A TypeScript port and modernization of the node IMAP module that makes communicating with IMAP servers easy",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./commands": {
			"types": "./dist/commands/index.d.ts",
			"default": "./dist/commands/index.js"
		},
		"./sasl": {
			"types": "./dist/sasl/index.d.ts",
			"default": "./dist/sasl/index.js"
		}
	},
	"dependencies": {
		"tiny-typed-emitter": "2.1.0",
		"utf7": "git+https://github.com/LoveAndCoding/utf7.git"
	},
	"scripts": {
		"build": "tsc -d",
		"typecheck": "tsc --noEmit && tsc -p test/docs/tsconfig.json --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run test/unit test/integration --coverage",
		"test:all": "npm test && npm run test:e2e && npm run test:compliance",
		"test:e2e": "vitest run test/e2e",
		"test:compliance": "vitest run --config test/compliance/vitest.config.ts",
		"typecheck:compliance": "tsc -p test/compliance/tsconfig.json --noEmit"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"keywords": [
		"imap",
		"mail",
		"email",
		"reader",
		"client"
	],
	"licenses": [
		{
			"type": "MIT",
			"url": "http://github.com/LoveAndCoding/imap/raw/master/LICENSE"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/LoveAndCoding/imap.git"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.9.4",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vitest": "^4.1.10"
	},
	"bugs": {
		"url": "https://github.com/LoveAndCoding/imap/issues"
	},
	"homepage": "https://github.com/LoveAndCoding/imap#readme",
	"directories": {
		"lib": "src",
		"test": "test"
	},
	"license": "MIT"
}
